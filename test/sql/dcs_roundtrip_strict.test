# name: test/sql/dcs_roundtrip_strict.test
# description: strict dcs_apply fails the same way for text, its DCS value, and dcs_format of that
#              value, for every corpus sheet whose first diagnostic is rule-level. GENERATED by
#              test/data/collect_strict.py: do not edit; re-run the script.
# group: [sql]

require dmb

statement ok
CREATE TYPE duck_block AS STRUCT(kind VARCHAR, element_type VARCHAR, content VARCHAR, level INTEGER,
    encoding VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER);

statement ok
CREATE MACRO b(k, t, c, lvl, attrs, o) AS
    {'kind': k, 'element_type': t, 'content': c, 'level': lvl, 'encoding': 'text',
     'attributes': attrs::MAP(VARCHAR, VARCHAR), 'element_order': o}::duck_block;

statement ok
CREATE TABLE docs AS SELECT * FROM (VALUES
  ('fx', [
    b('block', 'heading', 'Intro', 1, MAP {'heading_level': '1', 'id': 'intro'}, 0),
    b('block', 'paragraph', '', 1, MAP {}, 1),
    b('inline', 'text', 'Hello world', 2, MAP {}, 2),
    b('block', 'heading', 'Comments', 1, MAP {'heading_level': '2'}, 3),
    b('block', 'paragraph', '', 1, MAP {'class': 'note wide'}, 4),
    b('inline', 'text', 'First', 2, MAP {}, 5),
    b('block', 'list', '', 1, MAP {'list_type': 'bullet'}, 6),
    b('block', 'list_item', '', 2, MAP {}, 7),
    b('inline', 'text', 'a', 3, MAP {}, 8),
    b('block', 'list_item', '', 2, MAP {}, 9),
    b('inline', 'text', 'b', 3, MAP {}, 10),
    b('block', 'heading', 'End', 1, MAP {'heading_level': '2'}, 11),
    b('block', 'paragraph', '', 1, MAP {}, 12),
    b('inline', 'text', 'Bye', 2, MAP {}, 13)]),
  ('mixed', [
    b('block', 'heading', 'Title', 1, MAP {'heading_level': '1'}, 0),
    b('block', 'blockquote', '', 1, MAP {}, 1),
    b('block', 'paragraph', '', 2, MAP {}, 2),
    b('inline', 'text', 'Quoted ', 3, MAP {}, 3),
    b('inline', 'link', 'here', 3, MAP {'href': 'https://example.com/x'}, 4),
    b('block', 'code', 'a,b' || chr(10) || '1,2', 1, MAP {'language': 'csv'}, 5),
    b('block', 'image', 'pic', 1, MAP {'src': 'p.png'}, 6),
    b('block', 'heading', 'Comments', 1, MAP {'heading_level': '2'}, 7),
    b('block', 'paragraph', '', 1, MAP {}, 8),
    b('inline', 'text', 'Last', 2, MAP {}, 9)])
) v(name, doc);

