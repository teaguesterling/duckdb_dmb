# name: test/sql/dcs_apply_prune.test
# description: dcs_apply phase 2 -- prune: display none, sections, dedupe
# group: [sql]

require dmb

statement ok
CREATE TYPE duck_block AS STRUCT(kind VARCHAR, element_type VARCHAR, content VARCHAR, level INTEGER,
    encoding VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER);

statement ok
CREATE MACRO b(k, t, c, lvl, attrs, o) AS
    {'kind': k, 'element_type': t, 'content': c, 'level': lvl, 'encoding': 'text',
     'attributes': attrs::MAP(VARCHAR, VARCHAR), 'element_order': o}::duck_block;

# The fixture from dcs_match.test.
statement ok
CREATE TABLE fx AS SELECT [
  b('block', 'heading', 'Intro', 1, MAP {'heading_level': '1', 'id': 'intro'}, 0),
  b('block', 'paragraph', '', 1, MAP {}, 1),
  b('inline', 'text', 'Hello world', 2, MAP {}, 2),
  b('block', 'heading', 'Comments', 1, MAP {'heading_level': '2'}, 3),
  b('block', 'paragraph', '', 1, MAP {'class': 'note wide'}, 4),
  b('inline', 'text', 'First', 2, MAP {}, 5),
  b('block', 'list', '', 1, MAP {'list_type': 'bullet'}, 6),
  b('block', 'list_item', '', 2, MAP {}, 7),
  b('inline', 'text', 'a', 3, MAP {}, 8),
  b('block', 'list_item', '', 2, MAP {}, 9),
  b('inline', 'text', 'b', 3, MAP {}, 10),
  b('block', 'heading', 'End', 1, MAP {'heading_level': '2'}, 11),
  b('block', 'paragraph', '', 1, MAP {}, 12),
  b('inline', 'text', 'Bye', 2, MAP {}, 13)
] AS doc;

statement ok
CREATE MACRO applied(sheet) AS TABLE
    SELECT u.element_order AS o, u.element_type AS t, u.attributes AS a
    FROM (SELECT unnest(dcs_apply(doc, sheet)) AS u FROM fx);

# display: none drops the block and its whole subtree; element_order is renumbered with no
# level jump (Review Focus 5).
query IIII
SELECT o, t, c, l FROM (SELECT u.element_order AS o, u.element_type AS t, u.content AS c, u.level AS l
    FROM (SELECT unnest(dcs_apply(doc, 'list { display: none; }')) AS u FROM fx)) ORDER BY o;
----
0	heading	Intro	1
1	paragraph	(empty)	1
2	text	Hello world	2
3	heading	Comments	1
4	paragraph	(empty)	1
5	text	First	2
6	heading	End	1
7	paragraph	(empty)	1
8	text	Bye	2

# -dcs-prune: section drops a heading and everything under it, to the next heading of the
# same or higher rank.
query II
SELECT o, c FROM (SELECT u.element_order AS o, u.content AS c
    FROM (SELECT unnest(dcs_apply(doc, 'h2:contains("Comments") { -dcs-prune: section; }')) AS u FROM fx))
    WHERE c <> '' ORDER BY o;
----
0	Intro
2	Hello world
3	End
5	Bye

# -dcs-dedupe: text drops a block whose text repeats an earlier block's that the property also matched.
query I
SELECT list_transform(dcs_apply([
  b('block', 'paragraph', 'A', 1, MAP {}, 0),
  b('block', 'paragraph', 'B', 1, MAP {}, 1),
  b('block', 'paragraph', 'A', 1, MAP {}, 2)
], 'paragraph { -dcs-dedupe: text; }'), lambda x: x.content);
----
[A, B]

# Matching happens before pruning: a rule still sees the block a prune removes.
query III
SELECT u.element_order, u.element_type, u.attributes['seen']
FROM (SELECT unnest(dcs_apply(doc, '#intro { display: none; } #intro + paragraph { --seen: "1"; }')) AS u FROM fx)
WHERE u.element_order = 0;
----
0	paragraph	1

# -dcs-prune: section on a block that is not a heading changes nothing; strict raises it.
query I
SELECT dcs_apply(doc, 'paragraph { -dcs-prune: section; }') = doc FROM fx;
----
true

statement error
SELECT dcs_apply(doc, 'paragraph { -dcs-prune: section; }', true) FROM fx;
----
prune-section-not-heading
