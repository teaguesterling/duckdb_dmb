# name: test/sql/dcs_type_apply.test
# description: dcs_apply and dcs_explain take a DCS value, and a sheet never applies differently from
#              its own text (the spec's first anti-goal)
# group: [sql]

require dmb

statement ok
CREATE TYPE duck_block AS STRUCT(kind VARCHAR, element_type VARCHAR, content VARCHAR, level INTEGER,
    encoding VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER);

statement ok
CREATE MACRO b(k, t, c, lvl, attrs, o) AS
    {'kind': k, 'element_type': t, 'content': c, 'level': lvl, 'encoding': 'text',
     'attributes': attrs::MAP(VARCHAR, VARCHAR), 'element_order': o}::duck_block;

# The fixture from dcs_explain.test, plus a code block.
statement ok
CREATE TABLE fx AS SELECT [
  b('block', 'heading', 'Intro', 1, MAP {'heading_level': '1', 'id': 'intro'}, 0),
  b('block', 'paragraph', '', 1, MAP {}, 1),
  b('inline', 'text', 'Hello world', 2, MAP {}, 2),
  b('block', 'heading', 'Comments', 1, MAP {'heading_level': '2'}, 3),
  b('block', 'paragraph', '', 1, MAP {'class': 'note wide'}, 4),
  b('inline', 'text', 'First', 2, MAP {}, 5),
  b('block', 'list', '', 1, MAP {'list_type': 'bullet'}, 6),
  b('block', 'list_item', '', 2, MAP {}, 7),
  b('inline', 'text', 'a', 3, MAP {}, 8),
  b('block', 'list_item', '', 2, MAP {}, 9),
  b('inline', 'text', 'b', 3, MAP {}, 10),
  b('block', 'heading', 'End', 1, MAP {'heading_level': '2'}, 11),
  b('block', 'paragraph', '', 1, MAP {}, 12),
  b('inline', 'text', 'Bye', 2, MAP {}, 13),
  b('block', 'code', 'x = 1', 1, MAP {'language': 'python'}, 14)
] AS doc;

# Sheets from the other tests, covering every phase.
statement ok
CREATE TABLE sheets AS SELECT * FROM (VALUES
  ('p { --x: "a"; } .note { --x: "b"; }'),
  ('heading { -dcs-id: auto; }'),
  ('h2:contains("Comments") { -dcs-prune: section; }'),
  ('list { display: none; }'),
  ('paragraph { display: contents; }'),
  ('paragraph { -dcs-level: +1; } paragraph { -dcs-as: table; } paragraph { display: contents; }'),
  ('list { counter-reset: n 10; } li { counter-increment: n; } li::before { content: counter(n) " "; }'),
  ('code::after { content: "y"; }'),
  ('blockquote { order: 1; } p { order: first; }'),
  ('@frontmatter { title: text(h2:contains("Comments")); } h1 { --heading_level: 3; }'),
  ('list, image { -dcs-dedupe: text; }'),
  ('h2, h3 { --x: "a"; } h2 { --x: "b" !important; } .note { --x: "c"; }'),
  ('@media (format: html) { p { --x: "m"; } } p { --y: "n"; }'),
  (':bogus { --x: "y"; } p { --x: "z"; }'),
  ('#intro { display: none; } #intro + paragraph { --seen: "1"; }'),
  ('p { -dcs-colour: red; } li::before { content: "- "; }'),
  ('p { --x: "a" !important; } .note { --x: "b"; }'),
  -- found by the fresh review (2026-11-25): each applied differently as DCS
  ('p::before.x { content: "z"; }'),
  ('p { --x: "a"; } p { --x: attr(; }'),
  ('p { width: calc((100% - 2px) / 2); }'),
  ('p { --naïve: "x"; }'),
  ('@media (format: "html") { p { --x: "a"; } } p { --y: "b"; }')
) v(t);

# dcs_apply: the same document for text and for its DCS value.
query I
SELECT count(*) FROM sheets, fx WHERE dcs_apply(doc, t) IS DISTINCT FROM dcs_apply(doc, dcs_sheet(t));
----
0

# A guard that the fixture is not trivial: most sheets change the document. (11 of the first 16 do, measured
# 2026-11-25; display: contents, -dcs-as, code::after, order and -dcs-dedupe find nothing to change here.)
query I
SELECT n >= 10 FROM (SELECT count(*) AS n FROM sheets, fx WHERE dcs_apply(doc, t) IS DISTINCT FROM doc);
----
true

# dcs_explain: the same changes, with the same rule numbers.
query I
SELECT count(*) FROM sheets, fx WHERE dcs_explain(doc, t) IS DISTINCT FROM dcs_explain(doc, dcs_sheet(t));
----
0

# Stored in a table, then applied.
statement ok
CREATE TABLE st AS SELECT t, dcs_sheet(t) AS s FROM sheets;

query I
SELECT count(*) FROM st, fx WHERE dcs_apply(doc, t) IS DISTINCT FROM dcs_apply(doc, s);
----
0

# Stored in Parquet: test/sql/dcs_type_parquet.test (it needs the parquet extension).

# Built by hand in SQL, with the fields in another order and no positions.
query I
SELECT dcs_apply(doc, [{'meta': NULL, 'selector': 'p', 'extra': NULL,
                        'declarations': [{'value': '"a"', 'property': '--x', 'extra': NULL}]}])
       = dcs_apply(doc, 'p { --x: "a"; }')
FROM fx;
----
true

# Strict, a rule-level diagnostic: the same error, line and column included.
statement error
SELECT dcs_apply(doc, 'p { } h2:bogus { --x: "a"; }', true) FROM fx;
----
dcs_apply: unknown-pseudo-class at line 1, column 7: unknown pseudo-class :bogus

statement error
SELECT dcs_apply(doc, dcs_sheet('p { } h2:bogus { --x: "a"; }'), true) FROM fx;
----
dcs_apply: unknown-pseudo-class at line 1, column 7: unknown pseudo-class :bogus

statement error
SELECT dcs_apply(doc, dcs_sheet('p { --x: attr(; }'), true) FROM fx;
----
dcs_apply: bad-value at line 1, column 5: --x: unbalanced parentheses

# Columns count code points: é is one column.
statement error
SELECT dcs_apply(doc, dcs_sheet('h2:contains("é"), p:bogus { --x: "a"; }'), true) FROM fx;
----
dcs_apply: unknown-pseudo-class at line 1, column 19: unknown pseudo-class :bogus

# A rule on a later line.
statement error
SELECT dcs_apply(doc, 'p { }' || chr(10) || '  h2 { } h3:bogus { --x: "a"; }', true) FROM fx;
----
dcs_apply: unknown-pseudo-class at line 2, column 10: unknown pseudo-class :bogus

statement error
SELECT dcs_apply(doc, dcs_sheet('p { }' || chr(10) || '  h2 { } h3:bogus { --x: "a"; }'), true) FROM fx;
----
dcs_apply: unknown-pseudo-class at line 2, column 10: unknown pseudo-class :bogus

# A split list with a bad value has one diagnostic, for text and for DCS.
query I
SELECT count(*) FROM dcs_check('h2, h3 { --x: attr(; }');
----
1

statement error
SELECT dcs_apply(doc, dcs_sheet('h2, h3 { --x: attr(; }'), true) FROM fx;
----
dcs_apply: bad-value at line 1, column 10: --x: unbalanced parentheses

# A refused selector stays refused: a pseudo-element that is not last.
statement error
SELECT dcs_apply(doc, dcs_sheet('p::before.x { content: "z"; }'), true) FROM fx;
----
dcs_apply: pseudo-element-not-last at line 1, column 1: a pseudo-element must end its selector

# Diagnostics come in the text's order: a selector diagnostic before a value diagnostic.
statement error
SELECT dcs_apply(doc, 'p { --x: attr(; } h2:bogus { --y: "a"; }', true) FROM fx;
----
dcs_apply: unknown-pseudo-class at line 1, column 19: unknown pseudo-class :bogus

statement error
SELECT dcs_apply(doc, dcs_sheet('p { --x: attr(; } h2:bogus { --y: "a"; }'), true) FROM fx;
----
dcs_apply: unknown-pseudo-class at line 1, column 19: unknown pseudo-class :bogus

# A media format in quotes: text warns not-yet, and so does its DCS value.
statement error
SELECT dcs_apply(doc, dcs_sheet('@media (format: "html") { p { --x: "a"; } }'), true) FROM fx;
----
dcs_apply: not-yet at line 1, column 27: @media (format: "html") rules are not applied yet

# A value the value lexer can't read, on a property that is not evaluated: text has no diagnostic,
# so neither has its DCS value, in strict mode too.
query I
SELECT dcs_apply(doc, dcs_sheet('p { width: calc((100% - 2px) / 2); }'), true)
     = dcs_apply(doc, 'p { width: calc((100% - 2px) / 2); }', true) FROM fx;
----
true

# A text-level diagnostic stays with the text: strict text throws, its DCS value does not (intended).
statement error
SELECT dcs_apply(doc, '@import "x"; p { --x: "a"; }', true) FROM fx;
----
dcs_apply: not-yet at line 1, column 1: @import is not supported yet

query I
SELECT dcs_apply(doc, dcs_sheet('@import "x"; p { --x: "a"; }'), true) = dcs_apply(doc, 'p { --x: "a"; }') FROM fx;
----
true

# dcs_explain names the same rules when a refused rule comes first.
query I
SELECT list_transform(dcs_explain(doc, ':bogus { --x: "y"; } p { --x: "z"; }'), lambda c: c.rule)
     = list_transform(dcs_explain(doc, dcs_sheet(':bogus { --x: "y"; } p { --x: "z"; }')), lambda c: c.rule)
FROM fx;
----
true

# NULL gives NULL; a sheet that is not a list is still text.
query I
SELECT dcs_apply(doc, NULL::DCS) IS NULL FROM fx;
----
true

query I
SELECT dcs_apply(doc, 5) = dcs_apply(doc, '5') FROM fx;
----
true
